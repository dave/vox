<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.dave.vox</string>
  <key>ProgramArguments</key>
  <array><string>__HOME__/.local/bin/vox</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/vox.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/vox.log</string>
  <!-- launchd doesn't see your shell's environment. Use the keychain for API keys,
       or uncomment this and add them here (this file is in ~/Library/LaunchAgents, not the repo):
  <key>EnvironmentVariables</key>
  <dict>
    <key>GROQ_API_KEY</key><string>...</string>
  </dict>
  -->
</dict>
</plist>
